# 裝好 / 升級後立刻套用 kernel 設定(之後每次開機由 systemd-sysctl / systemd-modules-load 自己載)。
# 容器裡或 kernel 沒有 ntsync 會失敗,不擋安裝。
apply_kernel_conf() {
    sysctl -p /usr/lib/sysctl.d/99-maple-cask.conf >/dev/null 2>&1 || true
    modprobe ntsync 2>/dev/null || true
    # maple-timens 的 AppArmor 規則(MC-27)。只在這台的 AppArmor 解析得過時才放進 /etc/apparmor.d:
    # 舊版(Debian 12 / Ubuntu 22.04 的 3.0)不認識 abi/4.0 與 userns 規則,放進去每次開機都會報錯,
    # 而那些版本本來就沒限制 user namespace,不需要這份規則
    if command -v apparmor_parser >/dev/null &&
        apparmor_parser -Q -K /usr/share/maple-cask/apparmor/maple-cask 2>/dev/null; then
        install -m 644 /usr/share/maple-cask/apparmor/maple-cask /etc/apparmor.d/maple-cask
        [ -d /sys/kernel/security/apparmor ] && apparmor_parser -r -W /etc/apparmor.d/maple-cask 2>/dev/null || true
    fi
}

post_install() {
    apply_kernel_conf
}

post_upgrade() {
    apply_kernel_conf
}

# 這段提示跟 packaging/deb/postrm 是同一段,改的話兩邊一起改
post_remove() {
    # postinst 放的 AppArmor 規則不是 dpkg 管的檔,要自己收
    if [ -f /etc/apparmor.d/maple-cask ]; then
        apparmor_parser -R /etc/apparmor.d/maple-cask 2>/dev/null || true
        rm -f /etc/apparmor.d/maple-cask
    fi
    cat <<'EOF'
maple-cask:每個使用者的資料沒有被刪(prefix、wine runner、設定、登入 session、cmsdl):
  ~/.config/maplestory-tw  ~/.local/share/maplestory-tw  ~/.cache/maplestory-tw
  ~/.config/systemd/user/maple-keepalive.{service,timer}(開過 keepalive 才有)
  env.sh 裡 GAME_DIR 指的遊戲目錄(約 70GB)也還在。
下次請在移除套件前,以各使用者身分先跑 maple uninstall;現在要清就手動 rm -rf 上面的路徑。
kernel.split_lock_mitigate = 0 會維持到重開機。
EOF
}
