-static bool is_same_app_override_decoration( steamcompmgr_win_t *candidate, steamcompmgr_win_t *focus )
+// Override-redirect windows are normally only painted when they belong to the focused app
+// (same pid / same appid).  Input method candidate windows live in the IME daemon's own
+// process (fcitx5, ibus), so they would never be shown inside gamescope and the user types
+// blind.  Paint them by process name -- as decorations, not in the override slot: the
+// override takes the keyboard focus, and an input method window never wants key input.
+// Moving the focus to it and back while a key is down loses that key's release in the app.
+static gamescope::ConVar<std::string> cv_foreign_override_process_names( "foreign_override_process_names", "fcitx5,ibus-daemon,ibus-ui-gtk3",
+	"Comma separated process names whose override-redirect windows are painted even though they do not belong to the focused app (input method candidate windows)." );
+
+static bool win_is_foreign_override_allowed( steamcompmgr_win_t *w )
+{
+	if ( w->pid_name.empty() )
+		return false;
+
+	for ( std::string_view sName : gamescope::Split( cv_foreign_override_process_names, "," ) )
+	{
+		if ( sName == w->pid_name )
+			return true;
+	}
+	return false;
+}
