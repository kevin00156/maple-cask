index 18b799e0..d7ea8026 100644
--- a/src/steamcompmgr.cpp
+++ b/src/steamcompmgr.cpp
@@ -4193,6 +4193,26 @@ static bool is_same_app_override_decoration( steamcompmgr_win_t *candidate, stea
 		( candidate->hwndStyleEx & uDecorationStyle ) == uDecorationStyle;
 }
 
+// Override-redirect windows are normally only painted when they belong to the focused app
+// (same pid / same appid).  Input method candidate windows live in the IME daemon's own
+// process (fcitx5, ibus), so they would never be shown inside gamescope and the user types
+// blind.  Allow them by process name.
+static gamescope::ConVar<std::string> cv_foreign_override_process_names( "foreign_override_process_names", "fcitx5,ibus-daemon,ibus-ui-gtk3",
+	"Comma separated process names whose override-redirect windows are painted even though they do not belong to the focused app (input method candidate windows)." );
+
+static bool win_is_foreign_override_allowed( steamcompmgr_win_t *w )
+{
+	if ( w->pid_name.empty() )
+		return false;
+
+	for ( std::string_view sName : gamescope::Split( cv_foreign_override_process_names, "," ) )
+	{
+		if ( sName == w->pid_name )
+			return true;
+	}
+	return false;
+}
+
 static bool is_good_override_candidate( steamcompmgr_win_t *override, steamcompmgr_win_t* focus )
 {
 	// Some Chrome/Edge dropdowns (ie. FH5 xbox login) will automatically close themselves if you
@@ -4208,7 +4228,7 @@ static bool is_good_override_candidate( steamcompmgr_win_t *override, steamcompm
 	if ( is_same_app_override_decoration( override, focus ) )
 		return false;
 
-	if ( override->pid != focus->pid && !windows_share_app( override, focus ) )
+	if ( override->pid != focus->pid && !windows_share_app( override, focus ) && !win_is_foreign_override_allowed( override ) )
 		return false;
 
 	return override != focus && (rect.nX + rect.nWidth) > 0 && (rect.nY + rect.nHeight) > 0;
