diff --git a/dlls/winex11.drv/keyboard.c b/dlls/winex11.drv/keyboard.c
--- a/dlls/winex11.drv/keyboard.c
+++ b/dlls/winex11.drv/keyboard.c
@@ -1146,6 +1146,26 @@
 
 
 /***********************************************************************
+ *           X11DRV_KeyReleased
+ *
+ * Tell the server that a key is up as soon as its release is read.  The key-up proper may come
+ * later, when an input method forwards the event back, and the server must not go on
+ * auto-repeating the key until then.
+ */
+void X11DRV_KeyReleased( XKeyEvent *event )
+{
+    INPUT input = {.type = INPUT_KEYBOARD};
+
+    pthread_mutex_lock( &kbd_mutex );
+    input.ki.wScan = keyc2scan[event->keycode] & 0xff;
+    pthread_mutex_unlock( &kbd_mutex );
+    input.ki.dwFlags = KEYEVENTF_KEYUP;
+
+    NtUserSendHardwareInput( 0, SEND_HWMSG_KEY_RELEASED, &input, 0 );
+}
+
+
+/***********************************************************************
  *           set_async_key_state
  */
 static void set_async_key_state( const BYTE state[256] )
