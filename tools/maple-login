def ask_account(accounts: list[dict], remembered: dict | None) -> dict:
    """列出帳號讓使用者挑。上次選的當預設,直接按 Enter 就是它。"""
    default, matched = 1, False
    if remembered:
        for i, a in enumerate(accounts, 1):
            if a["sname"] == remembered.get("sname"):
                default, matched = i, True
                break
    print()
    for i, a in enumerate(accounts, 1):
        state = "  (停用)" if not a["enabled"] else ""
        last = "  ← 上次用的" if matched and i == default else ""
        print(f"  {i}. {pad(a['sname'], 14)} sid = {a['sid']}{state}{last}")
    print()
    while True:
        try:
            raw = input(f"選哪個?[1-{len(accounts)},直接 Enter = {default}] ").strip()
        except EOFError:
            raise bfotp.BFError("讀不到輸入,用 --name 或 --pick 指定帳號")
        if not raw:
            return accounts[default - 1]
        if raw.isdigit() and 1 <= int(raw) <= len(accounts):
            return accounts[int(raw) - 1]
        print(f"  要 1 到 {len(accounts)} 之間的數字,或直接按 Enter")


def pick_account(accounts: list[dict], name: str | None, remembered: dict | None,
                 pick: int | None = None) -> dict:
    """選一個遊戲帳號。

    多個帳號又沒指定時不再直接拋錯 —— 清單本來就在手上,讓人挑就好。
    不是 tty(管線 / 排程)才退回拋錯,因為那時沒有人可以回答。
    """
    if name:
        for a in accounts:
            if a["sname"] == name:
                return a
        names = "、".join(a["sname"] for a in accounts)
        raise bfotp.BFError(f"清單裡沒有 {name!r}。可用的是:{names}")
    if pick is not None:
        if not 1 <= pick <= len(accounts):
            raise bfotp.BFError(f"--pick 要在 1..{len(accounts)} 之間")
        return accounts[pick - 1]
    if len(accounts) == 1:
        return accounts[0]
    if not sys.stdin.isatty():
        names = "、".join(a["sname"] for a in accounts)
        raise bfotp.BFError(f"有多個遊戲帳號,請用 --name 或 --pick 指定:{names}")
    return ask_account(accounts, remembered)


def pad(s: str, width: int) -> str:
    """按終端機顯示寬度補空白 —— 全形字算兩格,ljust 會算成一格。"""
    w = sum(2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in s)
    return s + " " * max(0, width - w)


def to_clipboard(text: str) -> str | None:
    """依序試 klipper / xclip / wl-copy。成功回傳用的是哪一個,都不行回 None。"""
    if shutil.which("qdbus"):
        try:
            subprocess.run(
                ["qdbus", "org.kde.klipper", "/klipper",
                 "org.kde.klipper.klipper.setClipboardContents", text],
                check=True, capture_output=True, timeout=10,
            )
            return "klipper"
        except Exception:
            pass
    for tool, cmd in (("xclip", ["xclip", "-selection", "clipboard"]), ("wl-copy", ["wl-copy"])):
        if not shutil.which(tool):
            continue
        try:
            subprocess.run(cmd, input=text.encode(), check=True,
                           capture_output=True, timeout=10)
            return tool
        except Exception:
            pass
    return None


def show(accounts: list[dict], acct: dict, otp: str) -> None:
    print()
    print("─── 楓之谷登入資訊 " + "─" * 40)
    print()
    for a in accounts:
        mark = "▶" if a["sname"] == acct["sname"] else " "
        state = "" if a["enabled"] else "  (停用)"
        print(f"  {mark} {pad(a['sname'], 14)} sid = {a['sid']}{state}")
    print()
    print(f"  帳號欄要填的是 sid,不是帳號名稱 {acct['sname']}:")
    print()
    print(f"    帳號: {acct['sid']}")
    print(f"    密碼: {otp}")
    print()
    print("  ⚠ OTP 是一次性的;空的登入表單閒置約 2 分鐘會自己關 —— 現在就開遊戲")
    print()


def hand_over(acct: dict, otp: str, no_clip: bool, two_stage: bool) -> None:
    """把 sid / OTP 交到使用者手上。

    剪貼簿只有一格,所以「分別複製」只能分兩段:先給 sid,貼完按 Enter 換成 OTP。
    --run 走單段(不能停下來等,遊戲還沒開,那時沒地方貼)。
    剪貼簿不可用一律只印一行繼續,不當成錯誤。
    """
    if no_clip:
        return
    if not to_clipboard(acct["sid"]):
        print("  剪貼簿不可用(沒有 klipper / xclip / wl-copy),請手動複製")
        print()
        return
    if not (two_stage and sys.stdin.isatty()):
        print("  ✓ sid 已複製到剪貼簿,貼上後再手動輸入 OTP")
        print()
        return
    print("  ✓ 帳號(sid)在剪貼簿裡了")
    try:
        input("  → 貼完帳號按 Enter,把密碼換進剪貼簿…")
    except (EOFError, KeyboardInterrupt):
        print()
        return
    if to_clipboard(otp):
        print("  ✓ 密碼(OTP)在剪貼簿裡了")
    else:
        print("  密碼複製失敗,請照上面手動輸入")
    print()


# -----------------------------------------------------------------------------
# 自動輸入
# -----------------------------------------------------------------------------

MAPLETYPE = os.path.join(HERE, "mapletype.exe")


def game_pids() -> list[str]:
    """誰 map 了 $GAME_DIR 底下的檔案,誰就是遊戲行程。

    判準照 tools/dev/gametest.sh 的 gamepids():不看行程名稱(comm 只有 15 字元,
    BlackCipher64.aes 會被截成 BlackCipher64.a),也不看視窗標題
    (Konsole 的標題會顯示 cwd,曾被當成遊戲視窗)。
    """
    game_dir = os.environ.get("GAME_DIR")
    if not game_dir:
        return []
    pids = []
    for d in glob.glob("/proc/[0-9]*"):
        try:
            with open(os.path.join(d, "maps")) as f:
                if game_dir in f.read():
                    pids.append(os.path.basename(d))
        except OSError:
            continue  # 行程剛結束,或不是我們的
    return pids


def env_problem() -> str | None:
    """WINE_ROOT / WINEPREFIX / GAME_DIR 這份契約。缺什麼回一段話,齊全回 None。

    run.sh、prefix/setup-prefix.sh、mapletype.exe 要的是同一組變數,所以只檢查一次。
    """
    missing = [k for k in RUN_ENV if not os.environ.get(k)]
    if not missing:
        return None
    return (
        "沒設 " + "、".join(missing) + "\n"
        "  它們跟 run.sh / prefix/setup-prefix.sh 是同一份契約,照 env.example 設:\n"
        "      mkdir -p ~/.config/maplestory-tw && cp env.example ~/.config/maplestory-tw/env.sh"
    )


def build_mapletype() -> str | None:
    """mapletype.exe 不進 git(二進位):沒有、或比 .c 舊(git pull 過),就當場編。

    建置指令只有一份,在 mapletype.c 檔頭(build-wine.sh、setup-prefix.sh 也是這樣撈)。
    編不成但手上有舊的 exe 就照用;連舊的都沒有才回一段話。
    """
    src = MAPLETYPE[:-len(".exe")] + ".c"
    have = os.path.exists(MAPLETYPE)
    if have and os.path.getmtime(MAPLETYPE) >= os.path.getmtime(src):
        return None
    with open(src, encoding="utf-8") as f:
        m = re.search(r"x86_64-w64-mingw32-gcc .*", f.read())
    cmd = m.group(0).strip() if m else "(mapletype.c 檔頭沒有建置指令)"
    if m and shutil.which("x86_64-w64-mingw32-gcc"):
        print(f"  編 mapletype.exe:{cmd}", flush=True)
        r = subprocess.run(cmd, shell=True, cwd=HERE, capture_output=True, text=True)
        if r.returncode == 0:
            return None
        print(r.stderr.strip(), file=sys.stderr)
    if have:
        return None
    return ("沒有 mapletype.exe,也編不出來(要 mingw-w64):\n"
            f"      sudo apt install mingw-w64 && cd {HERE} && {cmd}")


def wine_ready() -> str | None:
    """跑 mapletype.exe 的前置條件。齊全回 None,缺什麼回一段話。"""
    problem = env_problem()
    if problem:
        return problem
    problem = build_mapletype()
    if problem:
        return problem
    # 一定要 prefix 對應的那份 wine。發行版的 /usr/bin/wine 版本不符,
    # 會在遊戲跑著的時候觸發 wineboot 去更新 prefix。
    if not os.access(os.path.join(os.environ["WINE_ROOT"], "bin", "wine"), os.X_OK):
        return f"{os.environ['WINE_ROOT']}/bin/wine 不能執行"
    return None


def has_https(pid: str) -> bool:
    """這個行程有沒有一條 ESTABLISHED、連到對方 443 的 TCP。"""
    inodes = set()
    for fd in glob.glob(f"/proc/{pid}/fd/*"):
        try:
            link = os.readlink(fd)
        except OSError:
            continue
        if link.startswith("socket:["):
            inodes.add(link[8:-1])
    for table in ("tcp", "tcp6"):
        try:
            with open(f"/proc/{pid}/net/{table}") as f:
                rows = f.read().splitlines()[1:]
        except OSError:
            continue
        for row in rows:
            col = row.split()
            # col[2] = 對方 ip:port(hex),col[3] = 狀態(01 = ESTABLISHED),col[9] = inode
            if col[3] == "01" and col[2].endswith(":01BB") and col[9] in inodes:
                return True
    return False


def wait_for_login_screen(timeout_sec: int) -> bool:
    """等遊戲載到登入表單。等到回 True。

    給「先開遊戲、再鑄 OTP」這個順序用的:OTP 只有 2 分鐘的窗口,表單出現了才鑄。
    訊號是 MapleStory.exe 的第一條 :443 連線。2026-09-27 經 gamescope 實測:
        視窗 t=4、8484 t=6(都在 NEXON Logo 之前,不能用)
        第一條 443 t=33~36(5 輪),截圖對到的兩輪表單在 t=35~36 / ≤40(對方 IP 每次不同,只能看 port)
        另兩輪載得慢(443 在 t=55/57),gamescopectl 截圖:命中那刻還在 LOADING,3 秒後表單已出現
        ——所以不能用固定延遲,命中後那 3 秒也不能省。另有一輪 t=19 就命中,沒截到圖,原因未查明
    驗證截圖用 GAMESCOPE_WAYLAND_DISPLAY=<遊戲的> gamescopectl screenshot <路徑.png>(不怕視窗被蓋)
    以前等的是「視窗存在」,t=4 就放行,OTP 打進 Logo 畫面整張燒掉。
    """
    print(f"  等遊戲載到登入表單(最多 {timeout_sec} 秒)…", flush=True)
    deadline = time.monotonic() + timeout_sec
    while time.monotonic() < deadline:
        for pid in game_pids():
            try:
                with open(f"/proc/{pid}/cmdline", "rb") as f:
                    if b"MapleStory.exe" not in f.read():
                        continue   # BlackCipher 之類也 map 了遊戲目錄,但不是它
            except OSError:
                continue
            if has_https(pid):
                time.sleep(3)      # 命中時可能還在 LOADING,實測 3 秒內表單都出來了
                return True
        time.sleep(0.5)
    return False


def auto_type(acct: dict, otp: str, submit: bool, mode: str, gap: int = 0) -> str | None:
    """把帳號 sid + OTP 打進遊戲的登入表單。做成回 None,做不成回一句「為什麼」。

    做不成一律退回剪貼簿 —— OTP 打錯要整個重開遊戲,這件事只能盡力而為,不能靜默失敗。
    """
    problem = wine_ready()
    if problem:
        return problem
    if not game_pids():
        return "遊戲沒在跑"
    cmd = mapletype_cmd() + ["--login", "--wait", "20000", "--mode", mode]
    if gap:
        # 0 = 一次灌完(預設)。掉字才調高,--gap 40 是 mapletype.c 實測過的人類節奏
        cmd += ["--gap", str(gap)]
    if submit:
        cmd.append("--submit")
    try:
        # OTP 走 stdin,不走 argv —— argv 會出現在 /proc/<pid>/cmdline,同機誰都讀得到
        r = subprocess.run(cmd, input=f"{acct['sid']}\n{otp}\n".encode(),
                           capture_output=True, timeout=90)
    except (OSError, subprocess.SubprocessError) as exc:
        return f"跑不起來({exc})"
    out = (r.stdout or b"").decode("utf-8", "replace").strip()
    if r.returncode != 0:
        return f"mapletype 回 {r.returncode}:{out.splitlines()[-1] if out else '沒有輸出'}"
    for line in out.splitlines():
        print("  " + line)
    return None


# -----------------------------------------------------------------------------
# 保活(systemd user timer)
# -----------------------------------------------------------------------------
#
# session 不是永久的:cookie 裡有兩個 ASP.NET_SessionId,ASP.NET 的 session state 預設是
# sliding expiration(閒置計時器,每次請求重置)。所以定期戳一下就能續命,不用一直重掃 QR。
# 但 bfWebToken 有沒有另一個「絕對壽命」還不知道 —— 真有的話保活只能延到那個上限,
# 到期仍得重掃。journal 就是這個問題的實驗紀錄:journalctl --user -u maple-keepalive
#
# 用 timer 不用常駐 service:跑完就退出,沒有狀態、崩了下次照跑、不用 pid 檔也不用防重入。

UNIT = "maple-keepalive"
KEEPALIVE_MINUTES = 10  # ASP.NET 預設 idle timeout 的一半,留足餘裕


def systemd_unit_dir() -> str:
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.path.join(base, "systemd", "user")


def systemctl(*args: str) -> bool:
    """跑 systemctl --user。成功回 True;沒有 systemd 或失敗都回 False,不拋例外。"""
    if not shutil.which("systemctl"):
        return False
    try:
        r = subprocess.run(["systemctl", "--user", *args],
                           capture_output=True, text=True, timeout=15)
        return r.returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def notify(title: str, body: str) -> None:
    """桌面通知。沒有 notify-send 就算了 —— 跟剪貼簿一樣,降級但不中斷。"""
    if not shutil.which("notify-send"):
        return
    try:
        subprocess.run(["notify-send", "-a", "maplestory-tw", title, body],
                       capture_output=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        pass


def keepalive_install() -> bool:
    """寫 unit 檔並啟動 timer。裝起來回 True,沒有 systemd 回 False。"""
    if not shutil.which("systemctl"):
        return False
    me = os.path.abspath(__file__)
    d = systemd_unit_dir()
    os.makedirs(d, exist_ok=True)
    # session 路徑若被 MAPLE_SESSION_FILE 覆寫,要帶進 unit —— systemd 看不到你 shell 的環境
    override = os.environ.get("MAPLE_SESSION_FILE")
    env = f"Environment=MAPLE_SESSION_FILE={override}\n" if override else ""
    with open(os.path.join(d, UNIT + ".service"), "w") as f:
        f.write(
            "[Unit]\n"
            "Description=maplestory-tw:戳一下 beanfun session 讓它不要過期\n"
            "\n[Service]\n"
            "Type=oneshot\n"
            f"{env}"
            f"ExecStart={me} keepalive\n"
        )
    with open(os.path.join(d, UNIT + ".timer"), "w") as f:
        f.write(
            "[Unit]\n"
            "Description=maplestory-tw:每 %d 分鐘保活一次 beanfun session\n"
            "\n[Timer]\n"
            "OnActiveSec=%dmin\n"
            "OnUnitActiveSec=%dmin\n"
            "AccuracySec=1min\n"
            "\n[Install]\n"
            "WantedBy=timers.target\n"
            % (KEEPALIVE_MINUTES, KEEPALIVE_MINUTES, KEEPALIVE_MINUTES)
        )
    systemctl("daemon-reload")
    return systemctl("enable", "--now", UNIT + ".timer")


def keepalive_ensure() -> None:
    """有活 session 就該有保活。裝過了就什麼都不做,所以每條路徑都能無腦呼叫。

    保活的條件是「手上有一個活的 session」,不是「你跑了哪個子命令」—— 綁在子命令上
    的話,走 `maple-login`(預設 otp,session 掛了自己退回掃 QR)那條路就永遠裝不起來。
    """
    d = systemd_unit_dir()
    if os.path.exists(os.path.join(d, UNIT + ".timer")):
        # 裝過了,但 unit 裡寫死的是「當時那份」maple-login 的路徑 —— repo 搬家或換一份 clone 之後
        # 它會一直跑舊路徑,舊的刪掉那天保活就默默失效。不是指向自己就重裝。
        try:
            with open(os.path.join(d, UNIT + ".service")) as f:
                current = f.read()
        except OSError:
            current = ""
        if f"ExecStart={os.path.abspath(__file__)} keepalive\n" in current:
            return
        if keepalive_install():
            print(f"保活改由這份 maple-login 執行:{os.path.abspath(__file__)}")
        return
    if keepalive_install():
        print(f"保活已啟動:每 {KEEPALIVE_MINUTES} 分鐘戳一次 session,省得一直重掃 QR。")
        print("  (看紀錄:journalctl --user -u maple-keepalive;停掉:tools/maple-login forget)")


def keepalive_remove() -> None:
    """停掉 timer 並刪掉 unit 檔。本來就沒裝也不會出事。"""
    systemctl("disable", "--now", UNIT + ".timer")
    d = systemd_unit_dir()
    for suffix in (".timer", ".service"):
        try:
            os.unlink(os.path.join(d, UNIT + suffix))
        except OSError:
            pass
    systemctl("daemon-reload")


def keepalive_state() -> str:
    """給 status 用的一行描述。"""
    if not shutil.which("systemctl"):
        return "沒有 systemd,保活沒裝"
    if not os.path.exists(os.path.join(systemd_unit_dir(), UNIT + ".timer")):
        return "保活沒裝(跑一次 tools/maple-login 就會自動裝)"
    if systemctl("is-active", "--quiet", UNIT + ".timer"):
        return f"保活跑著,每 {KEEPALIVE_MINUTES} 分鐘戳一次"
    return "保活裝了但沒在跑(systemctl --user start %s.timer)" % UNIT


