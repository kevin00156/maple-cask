    見 docs/known-issues.md)。做成函式而不是常數:MAPLE_LAUNCHER 可能寫在 env.sh 裡,要到 main() 載完才看得到。"""
    return os.environ.get("MAPLE_LAUNCHER") or os.path.join(HERE, "gs-run.sh")


def load_env() -> None:
    """沒 source env.sh 的話,自己載 $MAPLE_ENV(預設 ~/.config/maplestory-tw/env.sh)。
    交給 bash 去 source 再 env -0 倒回來,不自己解析 shell。"""
    if os.environ.get("WINE_ROOT"):
        return
    envf = os.environ.get("MAPLE_ENV") or os.path.join(
        os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "maplestory-tw", "env.sh")
    if not os.path.isfile(envf):
        return
    out = subprocess.run(["bash", "-c", 'source "$1" && env -0', "_", envf],
                         capture_output=True, check=False).stdout
    for kv in out.split(b"\0"):
        k, _, v = kv.partition(b"=")
        if k:
            os.environ[k.decode()] = v.decode()


