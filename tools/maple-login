# 子命令
# -----------------------------------------------------------------------------


def check_run_env() -> str | None:
    """--run 的前置條件。缺什麼就回一段話,齊全回 None。"""
    problem = env_problem()
    if problem:
        return "--run 要的環境變數" + problem
    if not os.access(launcher(), os.X_OK):
        return f"--run 需要可執行的 {launcher()},但它不在或不可執行"
    return None


def cmd_otp(args) -> int:
    # --run 的環境變數先驗 —— OTP 是一次性的,鑄完才發現不能跑就白燒一張。
    if args.run:
        problem = check_run_env()
        if problem:
            return die(problem, 2)

    try:
        login = open_session()
    except Exception as exc:
        print(f"session 不能用:{exc}", file=sys.stderr)
        print("→ 帶你重新登入,等一下會跳出 QR 圖,用 beanfun App 掃它", file=sys.stderr)
        login = qr_login(args.qr_timeout)

    keepalive_ensure()
    remembered = load_remembered()
    try:
        acct = pick_account(login.accounts, args.name, remembered, args.pick)
        if acct["sname"] != (remembered or {}).get("sname"):
            save_remembered(acct)  # 記住這次選的,下次不用再打 --name
        # 先選帳號再等視窗:不然人要乾等幾十秒才被問要用哪個帳號
        if args.wait_game:
            if not wait_for_login_screen(args.wait_game):
                print("  沒等到登入表單,還是照鑄(自己看畫面,打不進去就從剪貼簿貼)")
        otp = bfotp.get_otp(login.session, login.web_token, acct, *SERVICE)
    finally:
        login.close()

    show(login.accounts, acct, otp)

    # 遊戲開著就直接打進去;--run 例外(遊戲還沒開),--no-type 是手動關掉。
    typed = False
    if not (args.run or args.no_type):
        problem = auto_type(acct, otp, not args.no_submit, args.mode, args.gap)
        if problem:
            print(f"  自動輸入沒做成,改用剪貼簿 —— {problem}")
        else:
            typed = True
    if not typed:
        # --run 之後遊戲才開,那時還沒地方貼,所以只走單段(維持原本行為)
        hand_over(acct, otp, args.no_clip, two_stage=not args.run)

    if args.run:
        print(f"==> 啟動遊戲({acct['sname']})\n", flush=True)
        os.execv(launcher(), [launcher()])
    return 0


def cmd_login(args) -> int:
    login = qr_login(args.qr_timeout)
    try:
        acct = pick_account(login.accounts, args.name, load_remembered(), args.pick)
        save_remembered(acct)
    finally:
        login.close()
    print(f"\n登入成功,session 已存到 {session_path()}")
    for a in login.accounts:
        mark = "▶" if a["sname"] == acct["sname"] else " "
        print(f"  {mark} {pad(a['sname'], 14)} sid = {a['sid']}"
              + ("" if a["enabled"] else "  (停用)"))
    print("\n現在跑 tools/maple-login 就會直接鑄 OTP。")
    print(keepalive_state())
    return 0


def cmd_status(args) -> int:
    path = session_path()
    if not os.path.exists(path):
        return die(f"沒有 session({path})。跑 tools/maple-login 會自動帶你掃 QR。")
    try:
        login = open_session()
        login.close()
    except Exception as exc:
        return die(f"session 失效:{exc}")
    remembered = load_remembered()
    who = remembered["sname"] if remembered else "(還沒選過帳號)"
    print(f"session 還活著,看得到 {len(login.accounts)} 個遊戲帳號,目前記住的是 {who}")
    print(keepalive_state())
    return 0


def cmd_forget(args) -> int:
    path = session_path()
    if os.path.exists(path):
        os.unlink(path)
        print(f"session 已刪除({path})")
    else:
        print("本來就沒有 session")
    keepalive_remove()
    print("保活已停止")
    return 0


def cmd_keepalive(args) -> int:
    """給 systemd timer 跑的。戳一下 session 讓 sliding expiration 重新計時。"""
    if not os.path.exists(session_path()):
        # 重開機後 tmpfs 被清空是正常狀態,不是錯誤 —— 安靜收攤,別每 10 分鐘吵一次
        keepalive_remove()
        print("沒有 session(重開機?),保活停止")
        return 0
    try:
        login = open_session()
    except Exception as exc:
        keepalive_remove()
        print(f"session 失效({exc});保活停止", file=sys.stderr)
        notify("楓之谷 session 過期了", "要玩之前先跑 tools/maple-login login 重掃 QR")
        return 1
    try:
        save_session(login)  # 伺服器可能換了 cookie,不寫回下次就拿舊的去打
    finally:
        login.close()
    keepalive_ensure()  # timer 自己跑時早就在了;手動跑就是「我要保活」的意思
    print(f"session 還活著,{len(login.accounts)} 個遊戲帳號")
    return 0


COMMANDS = {"otp": cmd_otp, "login": cmd_login, "status": cmd_status,
            "forget": cmd_forget, "keepalive": cmd_keepalive}


def main() -> int:
    load_env()
    ap = argparse.ArgumentParser(
        prog="maple-login",
        description="取得楓之谷登入用的帳號 sid + OTP",
        epilog=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    ap.add_argument(
        "cmd", nargs="?", default="otp", choices=sorted(COMMANDS),
        help="otp(預設,可省略)/ login 強制重掃 QR / status 檢查 session / "
             "forget 刪 session / keepalive 戳一下 session(給 systemd timer 用)",
    )
    ap.add_argument("--name", metavar="名稱",
                    help="指定遊戲帳號名稱;只有一個帳號時可省略")
    ap.add_argument("--pick", type=int, metavar="N",
                    help="用編號選第 N 個帳號(1 開始);給腳本用,不會問問題")
    ap.add_argument("--run", action="store_true",
                    help="印完立刻啟動 run.sh(預設經 tools/gs-run.sh 進 gamescope;需要 WINE_ROOT / WINEPREFIX / GAME_DIR)")
    ap.add_argument("--no-clip", action="store_true", help="不要寫進剪貼簿")
    ap.add_argument("--wait-game", type=int, metavar="秒", default=0,
                    help="先等遊戲載到登入表單再鑄 OTP(配合『先開遊戲』的流程)")
    ap.add_argument("--no-type", action="store_true",
                    help="就算遊戲開著也不要自動輸入,只複製")
    ap.add_argument("--no-submit", action="store_true",
                    help="自動輸入後不要按登入,讓你自己確認(第一次用建議加這個)")
    ap.add_argument("--mode", default="char", choices=("char", "packet", "key", "both"),
                    help="自動輸入送哪種訊息,預設 char;打不進去時才換(見 mapletype.c 檔頭)")
    ap.add_argument("--gap", type=int, default=0, metavar="ms",
                    help="自動輸入時每個字元之間等幾毫秒,預設 0(一次灌完);掉字才調高,40 是實測過的人類節奏")
    ap.add_argument("--qr-timeout", type=int, default=180, metavar="秒",
                    help="等待掃碼秒數,預設 180")
    ap.add_argument("-v", "--verbose", action="store_true", help="把每一步印到 stderr")
    args = ap.parse_args()

    bfotp.VERBOSE = args.verbose
    try:
        return COMMANDS[args.cmd](args)
    except bfotp.BFError as exc:
        return die(f"錯誤:{exc}")
    except requests.RequestException as exc:
        return die(f"網路錯誤:{exc}")
    except KeyboardInterrupt:
        return die("\n中斷。", 130)


if __name__ == "__main__":
    sys.exit(main())
