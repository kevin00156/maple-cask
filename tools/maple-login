# 存檔:憑證放 tmpfs,偏好放 ~/.config
# -----------------------------------------------------------------------------
#
# 兩種資料的壽命不一樣,所以不放同一個檔:
#   session.json  bfWebToken + 整個 cookie jar,等同登入憑證 —— tmpfs、0600、重開機消失
#   prefs.json    上次選的遊戲帳號,沒有祕密 —— $XDG_CONFIG_HOME,重開機要還在


@dataclasses.dataclass
class Login:
    """一次登入的成果。

    accounts 要真的打過 API 才有內容 —— load_session() 只是讀檔,拿不到清單。
    """

    session: requests.Session
    web_token: str
    accounts: list[dict] = dataclasses.field(default_factory=list)

    def close(self) -> None:
        self.session.close()


def runtime_dir() -> str:
    base = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    d = os.path.join(base, "maplestory-tw")
    os.makedirs(d, mode=0o700, exist_ok=True)
    return d


def config_dir() -> str:
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.path.join(base, "maplestory-tw")


def session_path() -> str:
    override = os.environ.get("MAPLE_SESSION_FILE")
    return override if override else os.path.join(runtime_dir(), "session.json")


def prefs_path() -> str:
    """多開時每組各記各的帳號(maple -N 會設 MAPLE_INSTANCE);第 1 組沿用 prefs.json。"""
    n = os.environ.get("MAPLE_INSTANCE", "1")
    return os.path.join(config_dir(), "prefs.json" if n in ("", "1") else f"prefs-{n}.json")


def write_json(path: str, data: dict) -> None:
    """原子換檔寫 JSON(0600)。

    背景保活與前景指令會同時碰 session 檔,直接 O_TRUNC 寫的話中間有一段檔案是
    半截的,讀到的人會判定 session 壞掉、把你送去重掃 QR。
    """
    os.makedirs(os.path.dirname(path) or ".", mode=0o700, exist_ok=True)
    tmp = f"{path}.{os.getpid()}.tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(data, f)
        os.replace(tmp, path)  # 同目錄 rename 是原子的
    except Exception:
        os.unlink(tmp)
        raise


def save_session(login: Login) -> None:
    write_json(session_path(), {
        "web_token": login.web_token,
        "saved_at": time.time(),
        # domain/path 要一起存 —— bfotp.bfwebtoken() 會挑 portal host 看得到的那一份
        "cookies": [
            {"name": c.name, "value": c.value, "domain": c.domain, "path": c.path}
            for c in login.session.cookies
        ],
    })


def load_session() -> Login:
    """讀 session 檔。沒有檔案或檔案壞掉一律丟 BFError。"""
    path = session_path()
    if not os.path.exists(path):
        raise bfotp.BFError("沒有存好的 session")
    try:
        with open(path) as f:
            data = json.load(f)
        cookies = data["cookies"]
        web_token = data["web_token"]
    except (ValueError, KeyError, OSError) as exc:
        raise bfotp.BFError(f"session 檔讀不動({exc});當作沒有") from exc

    s = bfotp.new_session()
    for c in cookies:
        s.cookies.set_cookie(
            requests.cookies.create_cookie(
                name=c["name"], value=c["value"], domain=c["domain"], path=c["path"]
            )
        )
    bfotp.log("session 載入,已存 %d 秒" % int(time.time() - data.get("saved_at", 0)))
    return Login(s, web_token)


def open_session() -> Login:
    """載入 session 並實際打一次 API,順手把帳號清單填進來。"""
    login = load_session()
    try:
        login.accounts = bfotp.list_accounts(login.session, login.web_token, *SERVICE)
    except Exception:
        login.close()
        raise
    return login


def load_remembered() -> dict | None:
    """上次選的遊戲帳號。沒有或讀不動都回 None —— 這只是預設值,不值得害人卡住。"""
    try:
        with open(prefs_path()) as f:
            acct = json.load(f).get("account")
    except (ValueError, OSError):
        return None
    return acct if isinstance(acct, dict) and acct.get("sname") else None


def save_remembered(account: dict) -> None:
    write_json(prefs_path(), {"account": account, "saved_at": time.time()})


