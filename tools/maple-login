# QR 登入
# -----------------------------------------------------------------------------


def png_dark(png: bytes):
    """解 PNG,回傳 (寬, 高, dark(x, y))。看不懂的格式回 None。

    只認 bit depth 8、非交錯 —— 伺服器那張就是(250x250 RGB)。
    刻意不用 Pillow:這支工具只靠 requests,多一個相依就多一種
    「在別人機器上跑不起來」。
    """
    if png[:8] != b"\x89PNG\r\n\x1a\n":
        return None
    w = h = depth = ctype = interlace = 0
    idat, plte = [], b""
    i = 8
    while i + 8 <= len(png):
        ln = struct.unpack(">I", png[i:i + 4])[0]
        tag, body = png[i + 4:i + 8], png[i + 8:i + 8 + ln]
        if tag == b"IHDR":
            w, h, depth, ctype, _, _, interlace = struct.unpack(">IIBBBBB", body)
        elif tag == b"PLTE":
            plte = body
        elif tag == b"IDAT":
            idat.append(body)
        elif tag == b"IEND":
            break
        i += 12 + ln

    chans = {0: 1, 2: 3, 3: 1, 4: 2, 6: 4}.get(ctype)
    if depth != 8 or interlace != 0 or chans is None or not (idat and w and h):
        return None
    try:
        raw = zlib.decompress(b"".join(idat))
    except zlib.error:
        return None
    stride = w * chans
    if len(raw) != (stride + 1) * h:
        return None

    # 解 PNG 的 5 種列過濾器(規格 §9.2),解完 out 就是原始像素
    out = bytearray(stride * h)
    prev = bytearray(stride)
    pos = 0
    for y in range(h):
        ft = raw[pos]
        line = bytearray(raw[pos + 1:pos + 1 + stride])
        pos += stride + 1
        if ft:
            for x in range(stride):
                a = line[x - chans] if x >= chans else 0
                b = prev[x]
                if ft == 1:
                    line[x] = (line[x] + a) & 0xFF
                elif ft == 2:
                    line[x] = (line[x] + b) & 0xFF
                elif ft == 3:
                    line[x] = (line[x] + (a + b) // 2) & 0xFF
                elif ft == 4:
                    c = prev[x - chans] if x >= chans else 0
                    p = a + b - c
                    pa, pb, pc = abs(p - a), abs(p - b), abs(p - c)
                    line[x] = (line[x] + (a if pa <= pb and pa <= pc else b if pb <= pc else c)) & 0xFF
                else:
                    return None
        out[y * stride:(y + 1) * stride] = line
        prev = line

    if ctype == 3:
        if len(plte) < 3:
            return None

        def dark(x: int, y: int) -> bool:
            k = out[y * stride + x] * 3
            return plte[k] * 299 + plte[k + 1] * 587 + plte[k + 2] * 114 < 128000
    elif chans >= 3:

        def dark(x: int, y: int) -> bool:
            k = y * stride + x * chans
            return out[k] * 299 + out[k + 1] * 587 + out[k + 2] * 114 < 128000
    else:

        def dark(x: int, y: int) -> bool:
            return out[y * stride + x * chans] < 128

    return w, h, dark


def qr_matrix(png: bytes):
    """把伺服器那張 QR 還原成 n x n 的模組矩陣。不像 QR 就回 None。

    只是照模組中心取樣,**不重新編碼** —— 畫出來的內容與原圖逐位元相同,
    所以沒有「拿 deeplink 重繪會做出另一張 QR」的問題。
    """
    got = png_dark(png)
    if not got:
        return None
    w, h, dark = got

    cols = [x for x in range(w) if any(dark(x, y) for y in range(h))]
    rows = [y for y in range(h) if any(dark(x, y) for x in range(w))]
    if not cols or not rows:
        return None
    x0, x1, y0, y1 = cols[0], cols[-1], rows[0], rows[-1]

    # 左上角定位點最上面那一列剛好 7 個模組寬,拿它換算一個模組幾個像素
    run = 0
    while x0 + run <= x1 and dark(x0 + run, y0):
        run += 1
    if run < 7:
        return None
    mod = run / 7
    n = round((x1 - x0 + 1) / mod)
    if not (21 <= n <= 177 and n % 4 == 1) or abs((y1 - y0) - (x1 - x0)) > mod:
        return None

    m = [[dark(min(w - 1, int(x0 + (i + .5) * mod)), min(h - 1, int(y0 + (j + .5) * mod)))
          for i in range(n)] for j in range(n)]
    # 時序列(第 6 行/列)一定是黑白相間。對不上就是取樣歪了,寧可不畫也不畫錯
    if any(m[6][i] != (i % 2 == 0) or m[i][6] != (i % 2 == 0) for i in range(8, n - 8)):
        return None
    return m


def qr_to_terminal(png: bytes) -> bool:
    """把 QR 畫在終端機上。畫了回 True,畫不了(格式怪/視窗太小)回 False。

    一個字元格塞上下兩排模組(▀),字元格本來就是 1:2,這樣一個模組才是方的 ——
    手機掃得動的前提。背景自己塗白,不然深色主題的終端機掃不出來。
    """
    m = qr_matrix(png)
    if not m:
        return False
    quiet = 4  # QR 規格要求的靜區
    n = len(m) + 2 * quiet
    need_lines = (n + len(m) % 2) // 2
    cols, lines = shutil.get_terminal_size((80, 24))
    if n > cols or need_lines + 6 > lines:
        print(f"\n終端機太小,畫不下 {n}x{need_lines} 的 QR(現在 {cols}x{lines})。"
              "把視窗拉大或縮小字級(Ctrl+-)再試一次。")
        return False

    rows = [[0] * n for _ in range(quiet)]
    rows += [[0] * quiet + [int(v) for v in r] + [0] * quiet for r in m]
    rows += [[0] * n for _ in range(quiet + len(m) % 2)]
    print()
    for j in range(0, len(rows), 2):
        top, bot = rows[j], rows[j + 1]
        print("\033[107;30m" + "".join(BLOCK[(top[i], bot[i])] for i in range(n)) + "\033[0m")
    return True


def sandboxed(desktop: str) -> bool:
    """這個 .desktop 是 snap / flatpak 包的嗎?"""
    return any(os.path.exists(os.path.join(d, desktop)) for d in SANDBOX_DESKTOP_DIRS)


def open_image(path: str) -> str | None:
    """開圖片檢視器。回傳用了哪個,沒有能用的回 None。

    不能無腦 xdg-open:它照 mime 資料庫轉手,而預設處理器很可能是 snap / flatpak
    的瀏覽器 —— 沙盒裡讀不到 $XDG_RUNTIME_DIR,使用者只會看到「沒有權限查看」。
    所以先挑真的看圖程式,輪到 xdg-open 時先問它要轉給誰。
    """
    for tool in VIEWERS:
        exe = shutil.which(tool)
        if not exe or exe.startswith("/snap/"):
            continue
        try:
            subprocess.Popen([tool, path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return tool
        except OSError:
            continue

    if shutil.which("xdg-open"):
        try:
            handler = subprocess.run(
                ["xdg-mime", "query", "default", "image/png"],
                capture_output=True, text=True, timeout=10,
            ).stdout.strip()
        except (OSError, subprocess.SubprocessError):
            handler = ""
        if not (handler and sandboxed(handler)):
            try:
                subprocess.Popen(
                    ["xdg-open", path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
                )
                return "xdg-open"
            except OSError:
                pass
    return None


def qr_to_png(png: bytes) -> str:
    """把伺服器給的 QR PNG 寫到 tmpfs,回傳路徑。"""
    path = os.path.join(runtime_dir(), "qr.png")
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "wb") as f:
        f.write(png)
    return path


def show_qr(png: bytes, deeplink: str) -> str:
    """讓使用者看到 QR。優先畫在終端機,畫不了才找看圖程式。回傳圖檔路徑。"""
    path = qr_to_png(png)
    if qr_to_terminal(png):
        print("\n用 beanfun App 掃上面這張 QR。")
        print(f"  (掃不動的話,圖檔在 {path})")
    elif open_image(path):
        print(f"\n用 beanfun App 掃這張 QR:{path}")
        print("  (圖片檢視器沒自動跳出來的話,自己開這個檔)")
    else:
        print(f"\n用 beanfun App 掃這張 QR:{path}")
        print("  找不到能用的看圖程式 —— 系統預設的那個是 snap / flatpak 包的,")
        print(f"  沙盒裡讀不到 {runtime_dir()}。用瀏覽器開 file://{path} 也行。")
    if deeplink:
        print(f"\n  或在手機上直接開:{deeplink}")
    return path


def qr_login(timeout: int) -> Login:
    """整條 QR 登入 + 把憑證落地。選哪個帳號是呼叫端的事。"""
    s = bfotp.new_session()
    png_path = None
    try:
        skey = bfotp.get_session_key(s)
        token, index_url = bfotp.get_login_index(s, skey)
        png, deeplink = bfotp.init_qr(s, skey, index_url)

        png_path = show_qr(png, deeplink)
        print(f"\n等待掃描確認(最多 {timeout} 秒)...", flush=True)

        bfotp.poll_qr(s, index_url, token, timeout)
        print("已確認,收尾中...")
        web_token = bfotp.finalize_qr(s, skey, index_url)
        login = Login(s, web_token)
        login.accounts = bfotp.list_accounts(s, web_token, *SERVICE)
        # 先落地再讓呼叫端選帳號。順序反過來的話,多帳號又沒指定 --name 時
        # pick_account 會拋錯,剛掃到的 bfWebToken 就跟著沒了 —— 又得重掃一次 QR。
        save_session(login)
        keepalive_ensure()  # 誰叫的都一樣:手上有活 session 就該有保活
        return login
    except Exception:
        s.close()
        raise
    finally:
        if png_path and os.path.exists(png_path):
            os.unlink(png_path)


