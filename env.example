# ~/.config/maplestory-tw/env.sh 的範本:第一次跑 maple 會問遊戲目錄、從這份產生(只換 GAME_DIR),之後改那份。
#   tools/maple、tools/maple-login、tools/gs-run.sh 沒看到 WINE_ROOT 時會自己載它(另放別處就設 MAPLE_ENV 指過去);
#   prefix/setup-prefix.sh 與 run.sh 則要先 `source ~/.config/maplestory-tw/env.sh`。
# (用 Lutris / Heroic 的話,把同樣的變數填進它們的環境變數設定即可。)

# runner:保持這個預設,`maple update` 會下載跟腳本同版本的 Release 放到這裡並負責更新。
# 自己 build 的改指 build/build-wine.sh 的 out/(例如 $HOME/.local/share/maplestory-tw/build/out),maple update 就不碰 runner
export WINE_ROOT=$HOME/.local/share/maplestory-tw/runners/current

# prefix(不存在會由 setup-prefix.sh 新建)
export WINEPREFIX=$HOME/.local/share/maplestory-tw/prefix

# MapleStory 目錄(含 MapleStory.exe、Patcher.exe)。還沒有遊戲就填想放的位置,再跑 maple install 下載
export GAME_DIR=$HOME/Games/MapleStory

# 選用:一份 Windows 的 C:\Windows\Fonts(至少要有 mingliu.ttc),沒有的話字會糊但能玩
#export FONTS_DIR=$HOME/.local/share/maplestory-tw/winfonts

# 選用:build/build-gamescope.sh 建的 gamescope(有中文輸入法候選窗的 patch,見 docs/how-it-works.md §13)
#export PATH=$HOME/.local/share/maplestory-tw/gamescope/bin:$PATH

# 選用:遊戲裡要用手把就設 1。預設關:wine 讀手把不經過 gamescope,視窗沒 focus 也照收(docs/known-issues.md「手把預設關閉」)
#export MAPLE_GAMEPAD=1

# 選用:VRAM 上限 1 GB,超出的貼圖放系統記憶體。8 GB 以下獨顯又要同時跑別的遊戲時用(docs/known-issues.md「VRAM」)
#export DXVK_CONFIG="dxvk.maxMemoryBudget = 1024"
