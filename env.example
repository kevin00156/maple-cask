# 複製到 ~/.config/maplestory-tw/env.sh 改成你的路徑。
#   tools/maple、tools/maple-login、tools/gs-run.sh 沒看到 WINE_ROOT 時會自己載它(另放別處就設 MAPLE_ENV 指過去);
#   prefix/setup-prefix.sh 與 run.sh 則要先 `source ~/.config/maplestory-tw/env.sh`。
# (用 Lutris / Heroic 的話,把同樣的變數填進它們的環境變數設定即可。)

# runner:build/build-wine.sh 產出的 out/,或解開的 maplestory-tw-wine-*.tar.xz
export WINE_ROOT=$HOME/.local/share/maplestory-tw/build/out

# prefix(不存在會由 setup-prefix.sh 新建)
export WINEPREFIX=$HOME/.local/share/maplestory-tw/prefix

# 現成的 MapleStory 目錄(含 MapleStory.exe、Patcher.exe)
export GAME_DIR=$HOME/Games/MapleStory

# 選用:一份 Windows 的 C:\Windows\Fonts(至少要有 mingliu.ttc),沒有的話字會糊但能玩
#export FONTS_DIR=$HOME/.local/share/maplestory-tw/winfonts

# 選用:build/build-gamescope.sh 建的 gamescope(有中文輸入法候選窗的 patch,見 docs/how-it-works.md §13)
#export PATH=$HOME/.local/share/maplestory-tw/gamescope/bin:$PATH
